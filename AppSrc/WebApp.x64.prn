38271>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38274>>>        //  Análisis del InvokingObject
38274>>>        // Verificamos qué objeto nos llama (normalmente la lista o el botón de selección)
38274>>>        If (hoInvokingObject <> 0) Begin
38276>>>            Showln "Navegación iniciada por el objeto: " (Name(hoInvokingObject))
38279>>>        End
38279>>>>
38279>>>
38279>>>        Case Begin
38279>>>            Case (NavigateData.eNavigateType = nfFromMain)
38281>>>                // If from main, this is a propbably a main file Select to Zoom.
38281>>>                Case Break
38282>>>
38282>>>            Case (NavigateData.eNavigateType = nfFromParent)
38285>>>                // If from parent, this is a constrained drill down.
38285>>>                Case Break
38286>>>
38286>>>            Case (NavigateData.eNavigateType = nfFromChild)
38289>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38289>>>                Case Break
38290>>>
38290>>>            Case Else // must be nfUndefined
38290>>>
38290>>>        Case End
38290>>>
38290>>>        Send SetActionButtons
38291>>>
38291>>>    End_Procedure
38292>>>
38292>>>End_Object
