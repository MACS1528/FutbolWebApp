37693>>>
37693>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37696>>>        // Análisis del InvokingObject
37696>>>        If (hoInvokingObject <> 0) Begin
37698>>>            Showln "Navegación iniciada por el objeto: " (Name(hoInvokingObject))
37701>>>        End
37701>>>>
37701>>>
37701>>>        Case Begin
37701>>>            Case (NavigateData.eNavigateType = nfFromMain)
37703>>>                // If from main, this is a propbably a main file Select to Zoom.
37703>>>                Case Break
37704>>>
37704>>>            Case (NavigateData.eNavigateType = nfFromParent)
37707>>>                // If from parent, this is a constrained drill down.
37707>>>                Case Break
37708>>>
37708>>>            Case (NavigateData.eNavigateType = nfFromChild)
37711>>>                // TAREA Punto 2: Aquí entraría si viniéramos de una búsqueda inversa
37711>>>                Case Break
37712>>>
37712>>>            Case Else // must be nfUndefined
37712>>>
37712>>>        Case End
37712>>>
37712>>>        Send SetActionButtons
37713>>>
37713>>>    End_Procedure
37714>>>
37714>>>End_Object
