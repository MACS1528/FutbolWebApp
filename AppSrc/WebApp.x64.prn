38255>>>            Showln "Navegación iniciada por el objeto: " (Name(hoInvokingObject))
38258>>>        End
38258>>>>
38258>>>
38258>>>        Case Begin
38258>>>            Case (NavigateData.eNavigateType = nfFromMain)
38260>>>                // If from main, this is a propbably a main file Select to Zoom.
38260>>>                Case Break
38261>>>
38261>>>            Case (NavigateData.eNavigateType = nfFromParent)
38264>>>                // If from parent, this is a constrained drill down.
38264>>>                Case Break
38265>>>
38265>>>            Case (NavigateData.eNavigateType = nfFromChild)
38268>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38268>>>                Case Break
38269>>>
38269>>>            Case Else // must be nfUndefined
38269>>>
38269>>>        Case End
38269>>>
38269>>>        Send SetActionButtons
38270>>>
38270>>>    End_Procedure
38271>>>
38271>>>End_Object
