37798>>>    Object ojugadorposicion_DD is a cjugadorposicionDataDictionary
37800>>>        Set DDO_Server to ojugador_DD
37801>>>        Set DDO_Server to oposicion_DD
37802>>>
37802>>>        // Interceptamos el guardado en el búfer interno del DDO
37802>>>        Procedure OnSaveRecord
37805>>>            Integer iJugadorID iPosicionID iIntermediaID
37805>>>            
37805>>>            // Capturamos los valores que el usuario ha seleccionado en la interfaz
37805>>>            Move jugador.ID to iJugadorID
37806>>>            Move posicion.ID to iPosicionID
37807>>>            
37807>>>            If (iJugadorID > 0 and iPosicionID > 0) Begin
37809>>>                // Buscamos de forma limpia en el búfer si el jugador ya tenía registro previo
37809>>>                Clear jugadorposicion
37810>>>                Move iJugadorID to jugadorposicion.JugadorID
37811>>>                Find ge jugadorposicion by 2 // Index 2 (JugadorID)
37812>>>>
37812>>>                
37812>>>                // Si ya existía, recuperamos su ID primario para asegurar el UPDATE
37812>>>                If (Found and jugadorposicion.JugadorID = iJugadorID) Begin
37814>>>                    Move jugadorposicion.ID to iIntermediaID
37815>>>                    
37815>>>                    Clear jugadorposicion
37816>>>                    Move iIntermediaID to jugadorposicion.ID
37817>>>                    Find eq jugadorposicion by 1 // Index 1 (ID Primaria)
37818>>>>
37818>>>                End
37818>>>>
37818>>>                
37818>>>                // Forzamos los valores correctos en el búfer que se va a enviar a MariaDB
37818>>>                Move iJugadorID to jugadorposicion.JugadorID
37819>>>                Move iPosicionID to jugadorposicion.PosicionID
37820>>>            End
37820>>>>
37820>>>            
37820>>>            Forward Send OnSaveRecord
37822>>>        End_Procedure
37823>>>    End_Object
