38285>>>    Procedure SetActionButtons
38288>>>        tWebNavigateData NavigateData
38288>>>        tWebNavigateData NavigateData
38288>>>        Boolean bHasRecord
38288>>>        Handle hoDD
38288>>>
38288>>>        Get Server to hoDD
38289>>>        Get GetNavigateData to NavigateData
38290>>>        Get HasRecord of hoDD to bHasRecord
38291>>>
38291>>>        // let's hide all buttons and then Show the ones we want
38291>>>        WebSet pbRender of oEditBtn to False
38292>>>        WebSet pbRender of oSaveBtn to False
38293>>>        WebSet pbRender of oCancelChangesBtn to False
38294>>>        WebSet pbRender of oDeleteBtn to False
38295>>>
38295>>>        If (NavigateData.bReadOnly) Begin
38297>>>            WebSet pbRender of oEditBtn to True
38298>>>        End
38298>>>>
38298>>>        Else Begin
38299>>>            WebSet pbRender of oSaveBtn to True
38300>>>            WebSet pbRender of oCancelChangesBtn to True
38301>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38302>>>        End
38302>>>>
38302>>>    End_Procedure
