39108>>>        WebSet pbRender of oNewButton to True
39109>>>        WebSet pbRender of oDetailButton to True
39110>>>
39110>>>        Case Begin
39110>>>            Case (NavigateData.eNavigateType = nfFromParent)
39112>>>                // If from parent, this is a constrained drill down
39112>>>                Case Break
39113>>>
39113>>>            Case (NavigateData.eNavigateType = nfFromChild)
39116>>>                // If from child, this is a probably a parent lookup from a Zoom
39116>>>                Case Break
39117>>>
39117>>>            Case (NavigateData.eNavigateType = nfFromMain)
39120>>>                // If from main, this is a probably a main-file lookup from a Zoom
39120>>>                WebSet pbRender of oDetailButton to False
39121>>>                Case Break
39122>>>
39122>>>            Case Else // must be nfUndefined
39122>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
39122>>>
39122>>>        Case End
39122>>>
39122>>>    End_Procedure
39123>>>
