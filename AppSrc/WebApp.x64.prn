39087>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39090>>>        WebSet pbRender of oNewButton to True
39091>>>        WebSet pbRender of oDetailButton to True
39092>>>
39092>>>        Case Begin
39092>>>            Case (NavigateData.eNavigateType = nfFromParent)
39094>>>                // If from parent, this is a constrained drill down
39094>>>                Case Break
39095>>>
39095>>>            Case (NavigateData.eNavigateType = nfFromChild)
39098>>>                // If from child, this is a probably a parent lookup from a Zoom
39098>>>                Case Break
39099>>>
39099>>>            Case (NavigateData.eNavigateType = nfFromMain)
39102>>>                // If from main, this is a probably a main-file lookup from a Zoom
39102>>>                WebSet pbRender of oDetailButton to False
39103>>>                Case Break
39104>>>
39104>>>            Case Else // must be nfUndefined
39104>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
39104>>>
39104>>>        Case End
39104>>>
39104>>>    End_Procedure
39105>>>
