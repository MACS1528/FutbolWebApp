39053>>>                // If from parent, this is a constrained drill down
39053>>>                Case Break
39054>>>
39054>>>            Case (NavigateData.eNavigateType = nfFromChild)
39057>>>                // If from child, this is a probably a parent lookup from a Zoom
39057>>>                Case Break
39058>>>
39058>>>            Case (NavigateData.eNavigateType = nfFromMain)
39061>>>                // If from main, this is a probably a main-file lookup from a Zoom
39061>>>                WebSet pbRender of oDetailButton to False
39062>>>                Case Break
39063>>>
39063>>>            Case Else // must be nfUndefined
39063>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
39063>>>
39063>>>        Case End
39063>>>
39063>>>    End_Procedure
