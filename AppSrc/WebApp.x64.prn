38381>>>        // Cargar registro padre si viene de la lista
38381>>>        If (NavigateData.sRowId <> "") Begin
38383>>>            Send FindByRowId of oposicion_DD posicion.File_Number (DeserializeRowID(NavigateData.sRowId))
38384>>>        End
38384>>>>
38384>>>        
38384>>>        // Refrescar lista de la tabla puente
38384>>>        Send Rebuild_Constraints of ojugadorposicion_DD
38385>>>        
38385>>>        Forward Send OnNavigateForward NavigateData hoInvokingView hoInvokingObject
38387>>>        Send SetActionButtons
38388>>>    End_Procedure
