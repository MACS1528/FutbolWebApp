38276>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38279>>>        //  Análisis del InvokingObject
38279>>>        // Verificamos qué objeto nos llama (normalmente la lista o el botón de selección)
38279>>>        If (hoInvokingObject <> 0) Begin
38281>>>            Showln "Navegación iniciada por el objeto: " (Name(hoInvokingObject))
38284>>>        End
38284>>>>
38284>>>
38284>>>        Case Begin
38284>>>            Case (NavigateData.eNavigateType = nfFromMain)
38286>>>                // If from main, this is a propbably a main file Select to Zoom.
38286>>>                Case Break
38287>>>
38287>>>            Case (NavigateData.eNavigateType = nfFromParent)
38290>>>                // If from parent, this is a constrained drill down.
38290>>>                Case Break
38291>>>
38291>>>            Case (NavigateData.eNavigateType = nfFromChild)
38294>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38294>>>                Case Break
38295>>>
38295>>>            Case Else // must be nfUndefined
38295>>>
38295>>>        Case End
38295>>>
38295>>>        Send SetActionButtons
38296>>>
38296>>>    End_Procedure
38297>>>
38297>>>End_Object
