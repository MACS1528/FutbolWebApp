37819>>>        Set DDO_Server to ojugador_DD
37820>>>        Set DDO_Server to oposicion_DD
37821>>>
37821>>>        // Interceptamos el guardado en el búfer interno del DDO
37821>>>        Procedure OnSaveRecord
37824>>>            Integer iJugadorID iPosicionID iIntermediaID
37824>>>            
37824>>>            // Capturamos los valores que el usuario ha seleccionado en la interfaz
37824>>>            Move jugador.ID to iJugadorID
37825>>>            Move posicion.ID to iPosicionID
37826>>>            
37826>>>            If (iJugadorID > 0 and iPosicionID > 0) Begin
37828>>>                // Buscamos de forma limpia en el búfer si el jugador ya tenía registro previo
37828>>>                Clear jugadorposicion
37829>>>                Move iJugadorID to jugadorposicion.JugadorID
37830>>>                Find ge jugadorposicion by 2 // Index 2 (JugadorID)
37831>>>>
37831>>>                
37831>>>                // Si ya existía, recuperamos su ID primario para asegurar el UPDATE
37831>>>                If (Found and jugadorposicion.JugadorID = iJugadorID) Begin
37833>>>                    Move jugadorposicion.ID to iIntermediaID
37834>>>                    
37834>>>                    Clear jugadorposicion
37835>>>                    Move iIntermediaID to jugadorposicion.ID
37836>>>                    Find eq jugadorposicion by 1 // Index 1 (ID Primaria)
37837>>>>
37837>>>                End
37837>>>>
37837>>>                
37837>>>                // Forzamos los valores correctos en el búfer que se va a enviar a MariaDB
37837>>>                Move iJugadorID to jugadorposicion.JugadorID
37838>>>                Move iPosicionID to jugadorposicion.PosicionID
37839>>>            End
37839>>>>
37839>>>            
37839>>>            Forward Send OnSaveRecord
37841>>>        End_Procedure
37842>>>    End_Object
