38283>>>    Procedure SetActionButtons
38286>>>        tWebNavigateData NavigateData
38286>>>        tWebNavigateData NavigateData
38286>>>        Boolean bHasRecord
38286>>>        Handle hoDD
38286>>>
38286>>>        Get Server to hoDD
38287>>>        Get GetNavigateData to NavigateData
38288>>>        Get HasRecord of hoDD to bHasRecord
38289>>>
38289>>>        // let's hide all buttons and then Show the ones we want
38289>>>        WebSet pbRender of oEditBtn to False
38290>>>        WebSet pbRender of oSaveBtn to False
38291>>>        WebSet pbRender of oCancelChangesBtn to False
38292>>>        WebSet pbRender of oDeleteBtn to False
38293>>>
38293>>>        If (NavigateData.bReadOnly) Begin
38295>>>            WebSet pbRender of oEditBtn to True
38296>>>        End
38296>>>>
38296>>>        Else Begin
38297>>>            WebSet pbRender of oSaveBtn to True
38298>>>            WebSet pbRender of oCancelChangesBtn to True
38299>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38300>>>        End
38300>>>>
38300>>>    End_Procedure
38301>>>
38301>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38304>>>        // Close after save
38304>>>        Send NavigateClose Self
38305>>>    End_Procedure
38306>>>
38306>>>    // this will close the view after a delete
38306>>>    Procedure OnViewDeleted Handle hoDDO
38309>>>        Send NavigateClose Self
38310>>>    End_Procedure
38311>>>
38311>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38314>>>        Case Begin
38314>>>            Case (NavigateData.eNavigateType = nfFromMain)
38316>>>                // If from main, this is a propbably a main file Select to Zoom.
38316>>>                Case Break
38317>>>
38317>>>            Case (NavigateData.eNavigateType = nfFromParent)
38320>>>                // If from parent, this is a constrained drill down.
38320>>>                Case Break
38321>>>
38321>>>            Case (NavigateData.eNavigateType = nfFromChild)
38324>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38324>>>                Case Break
38325>>>
38325>>>            Case Else // must be nfUndefined
38325>>>
38325>>>        Case End
38325>>>
38325>>>        Send SetActionButtons
38326>>>
38326>>>    End_Procedure
38327>>>
38327>>>End_Object 
