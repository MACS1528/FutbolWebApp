38139>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38142>>>        //  Análisis del InvokingObject 
38142>>>        If (hoInvokingObject <> 0) Begin
38144>>>            Showln "Navegación iniciada por el objeto: " (Name(hoInvokingObject))
38147>>>        End
38147>>>>
38147>>>
38147>>>        Case Begin
38147>>>            Case (NavigateData.eNavigateType = nfFromMain)
38149>>>                Case Break
38150>>>            Case (NavigateData.eNavigateType = nfFromParent)
38153>>>                // Aquí podrías añadir lógica si vinieras desde una vista "Abuela"
38153>>>                Case Break
38154>>>            Case (NavigateData.eNavigateType = nfFromChild)
38157>>>                Case Break
38158>>>        Case End
38158>>>
38158>>>        // Lógica esencial para controlar la lista de equipos subordinada
38158>>>        If (NavigateData.bNewRecord) Begin
38160>>>            WebSet pbRender of oEquiposList to False // Oculta la lista si la liga es totalmente nueva
38161>>>        End
38161>>>>
38161>>>        Else Begin
38162>>>            WebSet pbRender of oEquiposList to True
38163>>>            Send GridRefresh of oEquiposList         // Fuerza la carga de los equipos asignados a esta liga
38164>>>        End
38164>>>>
38164>>>
38164>>>        Send SetActionButtons
38165>>>    End_Procedure
38166>>>
38166>>>End_Object
