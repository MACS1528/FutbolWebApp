39130>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39133>>>        WebSet pbRender of oNewButton to True
39134>>>        WebSet pbRender of oDetailButton to True
39135>>>
39135>>>        Case Begin
39135>>>            Case (NavigateData.eNavigateType = nfFromParent)
39137>>>                // If from parent, this is a constrained drill down
39137>>>                Case Break
39138>>>
39138>>>            Case (NavigateData.eNavigateType = nfFromChild)
39141>>>                // If from child, this is a probably a parent lookup from a Zoom
39141>>>                Case Break
39142>>>
39142>>>            Case (NavigateData.eNavigateType = nfFromMain)
39145>>>                // If from main, this is a probably a main-file lookup from a Zoom
39145>>>                WebSet pbRender of oDetailButton to False
39146>>>                Case Break
39147>>>
39147>>>            Case Else // must be nfUndefined
39147>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
39147>>>
39147>>>        Case End
39147>>>
39147>>>    End_Procedure
39148>>>
39148>>>End_Object
