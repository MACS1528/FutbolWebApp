37665>>>    Procedure SetActionButtons
37668>>>        tWebNavigateData NavigateData
37668>>>        tWebNavigateData NavigateData
37668>>>        Boolean bHasRecord
37668>>>        Handle hoDD
37668>>>
37668>>>        Get Server to hoDD
37669>>>        Get GetNavigateData to NavigateData
37670>>>        Get HasRecord of hoDD to bHasRecord
37671>>>
37671>>>        // let's hide all buttons and then Show the ones we want
37671>>>        WebSet pbRender of oEditBtn to False
37672>>>        WebSet pbRender of oSaveBtn to False
37673>>>        WebSet pbRender of oCancelChangesBtn to False
37674>>>        WebSet pbRender of oDeleteBtn to False
37675>>>
37675>>>        If (NavigateData.bReadOnly) Begin
37677>>>            WebSet pbRender of oEditBtn to True
37678>>>        End
37678>>>>
37678>>>        Else Begin
37679>>>            WebSet pbRender of oSaveBtn to True
37680>>>            WebSet pbRender of oCancelChangesBtn to True
37681>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37682>>>        End
37682>>>>
37682>>>    End_Procedure
