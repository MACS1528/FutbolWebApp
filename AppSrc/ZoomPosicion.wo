// C:\DataFlex Projects\FutbolWebApp\AppSrc\ZoomPosicion.wo
// ZoomPosicion - Versión completa y funcional
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebForm.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cWebGroup.pkg

Use cposicionDataDictionary.dd
Use cjugadorposicionDataDictionary.dd 

Object oZoomPosicion is a cWebView
    Set piColumnCount to 12
    Set psCaption to "Detalle de Posición"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set Verify_Save_Msg to 0
    Set piMaxWidth to 1024

    Object oposicion_DD is a cposicionDataDictionary
    End_Object 

    Object ojugadorposicion_DD is a cjugadorposicionDataDictionary
        Set DDO_Server to oposicion_DD
        
        // AÑADIDO: Esta restricción asegura que el puente solo muestre 
        // los jugadores vinculados a la posición actual.
        Procedure OnConstrain
            Forward Send OnConstrain
            Constrain jugadorposicion.PosicionID eq posicion.ID
        End_Procedure
    End_Object

    Set Main_DD to oposicion_DD
    Set Server  to oposicion_DD

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 4

        Object oGroupGeneral is a cWebGroup
            Set psCaption to "Información de la Posición"
            Set piColumnCount to 12

            Object oposicionID is a cWebForm
                Entry_Item posicion.ID
                Set piColumnSpan to 2
                Set piColumnIndex to 0
                Set peLabelPosition to lpTop
                Set psLabel to "ID"
            End_Object 

            Object oposicionNombre is a cWebForm
                Entry_Item posicion.Nombre
                Set piColumnSpan to 10
                Set piColumnIndex to 2
                Set peLabelPosition to lpTop
                Set psLabel to "Nombre de la Posición"
            End_Object 
        End_Object

        Object oGroupJugadores is a cWebGroup
            Set psCaption to "Jugadores en esta Posición"
            Set piColumnCount to 12

            Object oJugadoresList is a cWebList
                Set piHeight to 250
                Set pbFillHeight to False
                Set piColumnSpan to 12
                Set Server to ojugadorposicion_DD 
                Set psCSSClass to "MobileList"
                Set pbShowHeader to True

                Object ojugador_Nombre is a cWebColumn
                    Entry_Item jugador.Nombre 
                    Set psCaption to "Nombre del Jugador"
                    Set piWidth to 300
                End_Object
            End_Object
        End_Object
    End_Object 

    Object oActionGroup is a cWebMenuGroup
        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Guardar"
            Procedure OnClick
                Send Request_Save
            End_Procedure
        End_Object 

        Object oEditBtn is a cWebMenuItem
            Set psCSSClass to "WebEditMenuItem"
            Set psCaption to "Editar"
            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure
        End_Object 

        Object oDeleteBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Eliminar"
            Set peActionDisplay to adMenu
            Procedure OnClick
                Send Request_Delete
            End_Procedure
        End_Object 

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCSSClass to "WebIcon_Refresh"
            Set psCaption to "Descartar Cambios"
            Set peActionDisplay to adMenu
            Procedure OnClick
                Send RefreshRecord
            End_Procedure
        End_Object 
    End_Object 

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord

        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to False

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn to bHasRecord
        End
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        Send NavigateClose Self
    End_Procedure

    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        // Cargar registro padre si viene de la lista
        If (NavigateData.sRowId <> "") Begin
            Send FindByRowId of oposicion_DD posicion.File_Number (DeserializeRowID(NavigateData.sRowId))
        End
        
        // Refrescar lista de la tabla puente
        Send Rebuild_Constraints of ojugadorposicion_DD
        
        Forward Send OnNavigateForward NavigateData hoInvokingView hoInvokingObject
        Send SetActionButtons
    End_Procedure

End_Object