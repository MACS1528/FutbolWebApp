// C:\DataFlex Projects\FutbolWebApp\AppSrc\ZoomJugador.wo
// ZoomJugador
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebForm.pkg
Use cWebGroup.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd
Use cposicionDataDictionary.dd
Use cjugadorposicionDataDictionary.dd

Object oZoomJugador is a cWebView
    Set piColumnCount to 12
    Set psCaption to "Detalle del Jugador"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set Verify_Save_Msg to 0
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server to oliga_DD
    End_Object 

    Object oposicion_DD is a cposicionDataDictionary
    End_Object

    Object ojugador_DD is a cjugadorDataDictionary
        Set DDO_Server to oequipo_DD
    End_Object 

    Object ojugadorposicion_DD is a cjugadorposicionDataDictionary
        Set DDO_Server to ojugador_DD
        Set DDO_Server to oposicion_DD

        // Interceptamos el guardado en el búfer interno del DDO
        Procedure OnSaveRecord
            Integer iJugadorID iPosicionID iIntermediaID
            
            // Capturamos los valores que el usuario ha seleccionado en la interfaz
            Move jugador.ID to iJugadorID
            Move posicion.ID to iPosicionID
            
            If (iJugadorID > 0 and iPosicionID > 0) Begin
                // Buscamos de forma limpia en el búfer si el jugador ya tenía registro previo
                Clear jugadorposicion
                Move iJugadorID to jugadorposicion.JugadorID
                Find ge jugadorposicion by 2 // Index 2 (JugadorID)
                
                // Si ya existía, recuperamos su ID primario para asegurar el UPDATE
                If (Found and jugadorposicion.JugadorID = iJugadorID) Begin
                    Move jugadorposicion.ID to iIntermediaID
                    
                    Clear jugadorposicion
                    Move iIntermediaID to jugadorposicion.ID
                    Find eq jugadorposicion by 1 // Index 1 (ID Primaria)
                End
                
                // Forzamos los valores correctos en el búfer que se va a enviar a MariaDB
                Move iJugadorID to jugadorposicion.JugadorID
                Move iPosicionID to jugadorposicion.PosicionID
            End
            
            Forward Send OnSaveRecord
        End_Procedure
    End_Object

    Set Main_DD to ojugadorposicion_DD
    Set Server  to ojugadorposicion_DD


    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 4

        // --- GRUPO: DATOS PERSONALES ---
        Object oGroupPersonal is a cWebGroup
            Set psCaption to "Datos Personales"
            Set piColumnCount to 12

            Object ojugadorID is a cWebForm
                Entry_Item jugador.ID
                Set piColumnSpan to 2
                Set piColumnIndex to 0
                Set peLabelPosition to lpTop
                Set psLabel to "ID"
            End_Object 

            Object ojugadorNombre is a cWebForm
                Entry_Item jugador.Nombre
                Set piColumnSpan to 5
                Set piColumnIndex to 2
                Set peLabelPosition to lpTop
                Set psLabel to "Nombre"
            End_Object 

            Object ojugadorApellido is a cWebForm
                Entry_Item jugador.Apellido
                Set piColumnSpan to 5
                Set piColumnIndex to 7
                Set peLabelPosition to lpTop
                Set psLabel to "Apellido"
            End_Object 
        End_Object

        // --- GRUPO: INFORMACIÓN DEPORTIVA ---
        Object oGroupDeportivo is a cWebGroup
            Set psCaption to "Información Deportiva"
            Set piColumnCount to 12

            Object ojugadorNacionalidad is a cWebForm
                Entry_Item jugador.Nacionalidad
                Set piColumnSpan to 6
                Set piColumnIndex to 0
                Set peLabelPosition to lpTop
                Set psLabel to "Nacionalidad"
            End_Object 

            Object ojugadorposicionPosicion is a cWebForm
                Entry_Item posicion.Nombre
                Set piColumnSpan to 6
                Set piColumnIndex to 6
                Set peLabelPosition to lpTop
                Set psLabel to "Posición Actual"
                Set pbReadOnly to True
            End_Object

            Object oequipoID is a cWebForm
                Entry_Item equipo.ID
                Set piColumnSpan to 2
                Set piColumnIndex to 0
                Set peLabelPosition to lpTop
                Set psLabel to "Equipo ID"
                Set pbPromptButton to True
                WebRegisterPath ntNavigateForward oEquipo
                Procedure OnPrompt
                    Send NavigatePath
                End_Procedure
            End_Object 

            Object oequipoNombre is a cWebForm
                Entry_Item equipo.Nombre
                Set piColumnSpan to 10
                Set piColumnIndex to 2
                Set peLabelPosition to lpTop
                Set psLabel to "Nombre del Equipo"
                Set pbReadOnly to True
            End_Object

            // Para realizar la asignación de la nueva posición mediante la lupa
            Object oposicionNombre is a cWebForm
                Entry_Item posicion.Nombre
                Set piColumnSpan to 12
                Set piColumnIndex to 0
                Set peLabelPosition to lpTop
                Set psLabel to "Seleccionar Posición"
                Set pbPromptButton to True
                WebRegisterPath ntNavigateForward oPosicion
                Procedure OnPrompt
                    Send NavigatePath
                End_Procedure
            End_Object
        End_Object
    End_Object 

    Object oActionGroup is a cWebMenuGroup
        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Save"
            Procedure OnClick
                Send Request_Save
            End_Procedure
        End_Object 

        Object oEditBtn is a cWebMenuItem
            Set psCSSClass to "WebEditMenuItem"
            Set psCaption to "Edit"
            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure
        End_Object 

        Object oDeleteBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Delete"
            Set peActionDisplay to adMenu
            Procedure OnClick
                Send Request_Delete
            End_Procedure
        End_Object 

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCSSClass to "WebIcon_Refresh"
            Set psCaption to "Clear Changes"
            Set peActionDisplay to adMenu
            Procedure OnClick
                Send RefreshRecord
            End_Procedure
        End_Object 
    End_Object 

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord

        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to False

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn to bHasRecord
        End
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        Send NavigateClose Self
    End_Procedure

    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    // Sincronización al entrar a la vista mediante los índices relacionales
    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        Handle hoMainDD hoJugadorDD
        Boolean bTieneJugador
        
        Get Server to hoMainDD
        Get ojugador_DD to hoJugadorDD
        
        Get HasRecord of hoJugadorDD to bTieneJugador
        
        If (bTieneJugador) Begin
            Clear jugadorposicion
            Move jugador.ID to jugadorposicion.JugadorID
            Find ge jugadorposicion by 2
            If (Found and jugadorposicion.JugadorID = jugador.ID) Begin
                Send Request_Assign of hoMainDD jugadorposicion.File_Number
            End
        End

        Send SetActionButtons
    End_Procedure

End_Object